{
  "name": "dukanpos",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "productName": "Asan POS",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:desktop": "node --test \"electron/test/*.test.cjs\"",
    "test:all": "npm test && npm run test:desktop",
    "stage:desktop": "node electron/scripts/stage-desktop.cjs",
    "start:desktop": "npm run stage:desktop && electron .",
    "package:win": "npm run stage:desktop && electron-rebuild -f -w bcrypt -w skia-canvas --arch x64 --module-dir .stage/backend && electron-builder --win nsis --x64",
    "release:win": "powershell -ExecutionPolicy Bypass -File electron/scripts/build-windows.ps1",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@react-pdf/renderer": "^4.5.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/jsbarcode": "^3.11.4",
    "axios": "^1.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.3.1",
    "hook": "^0.1.0",
    "input-otp": "^1.4.2",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.18.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.79.0",
    "react-phone-number-input": "^3.4.17",
    "react-router": "^7.17.0",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.9.0",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "use-debounce": "^10.1.1",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.asanpos.desktop",
    "productName": "Asan POS",
    "artifactName": "Asan POS Setup-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "electron-dist"
    },
    "files": [
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/lib/**",
      "node_modules/dotenv/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".stage/renderer",
        "to": "renderer",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": ".stage/backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/.env*",
          "!**/backend.env",
          "!**/*.map",
          "!**/*.d.ts"
        ]
      },
      {
        "from": ".stage/backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*",
          "!**/.env*",
          "!**/backend.env",
          "!**/*.map",
          "!**/*.d.ts",
          "!**/test/**",
          "!**/tests/**",
          "!**/__tests__/**"
        ]
      },
      {
        "from": ".stage/docker",
        "to": "docker",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Asan POS",
      "deleteAppDataOnUninstall": false
    }
  }
}
